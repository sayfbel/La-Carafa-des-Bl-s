# ==============================================================================
# La Carafa des Blés — Variables d'Environnement (Exemple Documenté)
# Ne jamais commiter le fichier .env réel contenant des secrets dans Git.
# ==============================================================================

# Environnement d'exécution (development | test | production)
NODE_ENV=development

# Port d'écoute du serveur Express
PORT=5000

# Origine du client frontend autorisée pour les requêtes CORS
CLIENT_ORIGIN=http://localhost:5173

# Configuration de la base de données MySQL / MariaDB (XAMPP local par défaut)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=la_carafa_db
DB_TEST_NAME=la_carafa_test
DB_USER=root
DB_PASSWORD=

# Sécurité des sessions et cookies
# En production, générer une clé aléatoire forte : openssl rand -base64 48
SESSION_SECRET=la-carafa-artisanal-secret-key-change-in-production-2026
COOKIE_SECURE=false

# Niveau de journalisation (error | warn | info | debug)
LOG_LEVEL=info

# Configuration des téléversements de médias
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=5
