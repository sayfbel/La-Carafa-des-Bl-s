{
  "name": "la-carafa-server",
  "version": "1.0.0",
  "description": "Backend API and MySQL data layer for La Carafa des Blés",
  "private": true,
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "echo 'Server ready'",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
